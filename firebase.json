{
  "hosting": {
    "public": "dist/palagai/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/subscriber-share.png",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"ChatGPT-Image-Apr-26-2026.png\""
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
