.login-wrapper {
  height: 94vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #ffffff;
  font-family: system-ui, -apple-system, sans-serif;
}

.login-card {
  position: relative;
  width: 360px;
  padding: 32px;
  border: 2px solid #111;
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 10px 28px rgba(0,0,0,0.08);
  overflow: hidden;
}

/* Decorative slashes */
.slash {
  position: absolute;
  width: 120%;
  height: 4px;
  left: -10%;
  opacity: 0.8;
}

.blue {
  top: 0;
  background: #4f46e5;
}

.orange {
  top: 6px;
  background: #f97316;
}

.green {
  top: 12px;
  background: #22c55e;
}

/* Text */
.title {
  margin-top: 28px;
  text-align: center;
  font-size: 28px;
  font-weight: 700;
}

.subtitle {
  text-align: center;
  font-size: 14px;
  color: #555;
  margin-bottom: 24px;
}

/* Input */
input {
  width: 100%;
  padding: 12px;
  border: 2px solid #111;
  border-radius: 10px;
  font-size: 14px;
  outline: none;
}

input:focus {
  border-color: #4f46e5;
}

/* Button */
button {
  width: 100%;
  margin-top: 16px;
  padding: 12px;
  background: #111;
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: 14px;
  cursor: pointer;
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Message */
.message {
  margin-top: 12px;
  font-size: 13px;
  text-align: center;
  color: #111;
}

/* Micro copy */
.micro-line {
  margin-top: 24px;
  font-size: 12px;
  text-align: center;
  color: #777;
}
