{
  "name": "palagai",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "clean": "if exist .angular rmdir /s /q .angular && if exist node_modules\\.vite rmdir /s /q node_modules\\.vite && echo Cache cleared",
    "prestart": "npm run clean",
    "start": "cross-env NODE_OPTIONS=--no-deprecation ng serve",
    "build": "cross-env NODE_OPTIONS=--no-deprecation ng build",
    "watch": "cross-env NODE_OPTIONS=--no-deprecation ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:palagai": "cross-env NODE_OPTIONS=--no-deprecation node dist/palagai/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/animations": "^21.0.8",
    "@angular/cdk": "^21.0.6",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.6",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/service-worker": "^21.1.0",
    "@angular/ssr": "^21.0.5",
    "express": "^5.1.0",
    "firebase": "^12.7.0",
    "ngx-quill": "^30.0.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.5",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "cross-env": "^10.1.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
